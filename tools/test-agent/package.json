{
  "name": "taskly-test-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unit test agent for Taskly: analyzes changes, writes Vitest tests, verifies them.",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "test-agent": "src/cli.ts"
  },
  "scripts": {
    "agent": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
